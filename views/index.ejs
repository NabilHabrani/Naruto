    <%- include("partials/header") %>
    
    <main>

<form action="/" method="get" class="search">
    <img src="/images/search.png" alt=""><input type="text" name="s" value="<%= searchQuery %>" placeholder="Zoek op naam">
    <input type="hidden" name="sort" value="<%= sortField %>">
    <input type="hidden" name="dir" value="<%= sortDirection %>">
    <button type="submit">Zoek</button>
</form>

    <table>
    <thead>
        <tr>
            <th><a href="/?sort=name&dir=<%= sortField === "name" && sortDirection === "asc" ? "desc" : "asc" %>&s=<%= searchQuery %>">Naam</a></th>
            <th><a href="/?sort=birthdate&dir=<%= sortField === "birthdate" && sortDirection === "asc" ? "desc" : "asc" %>&s=<%= searchQuery %>">Geboortedatum</a></th>
            <th>Hobbies</th>
            <th>Positie</th>
            <th>Beschrijving</th>
        </tr>
    </thead>
    <tbody>
        <% for(let character of characters) { %>
        <tr>
            <td>
                <div class="names">
                    <a href="/characters/<%= character.id %>">
                        <img src="<%= character.image_url %>" alt="<%= character.name %>">
                        <h1><%= character.name %></h1>
                    </a>
                </div>
            </td>
            <td><%= character.birthdate %></td>
            <td class="hobbies">
                <% for(let hobby of character.hobbies) { %>
                    <p><%= hobby %></p>
                <% } %>
            </td>
            <td><%= character.position %></td>
            <td><%= character.description %></td>
        </tr>
        <% } %>
    </tbody>
</table>


    </main>

    <%- include("partials/footer") %>


