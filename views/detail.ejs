<%- include("partials/header") %>    
    <main class="card-detail">

         <article class="character-card-detail">
            <div class="card-corner top-left"></div>
            <div class="card-corner top-right"></div>
            <div class="card-corner bottom-left"></div>
            <div class="card-corner bottom-right"></div>

            <div class="card-header">
                <span class="card-id">№ <%= character.id.toString().padStart(2, '0') %></span>
            </div>

            <div class="portrait-frame">
                <img src="<%= character.image_url %>" alt="<%= character.name %>" class="portrait" />
            </div>

            <h2 class="character-name"><%= character.name %></h2>
            <p class="character-position"><%= character.position %></p>

            <p class="character-description">
                <%= character.description %>
            </p>

            <div class="info-grid">
                <div class="info-row">
                    <span class="info-label">Leeftijd</span>
                    <span class="info-value"><%= character.age %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Geboortedatum</span>
                    <span class="info-value"><%= character.birthdate %></span>
                </div>
            </div>

            <div class="hobbies-section">
                <h3 class="section-heading">Hobby's</h3>
                <ul class="hobbies-list">
                    <% for(let hobby of character.hobbies) { %>
                        <li><%= hobby %></li>
                    <% } %>
                </ul>
            </div>

            <div class="team-section">
                <h3 class="section-heading">Team</h3>
                <p class="team-name"><%= character.team.name %></p>
                <p class="team-detail"><span>Dorp:</span> <%= character.team.village %></p>
            </div>

            <button class="edit-detail">
                <a href="/characters/<%= character.id %>/edit" class="edit-button">Bewerk</a>
            </button>


          



        </article>



            
    
    
    
    </main>

    <%- include("partials/footer") %>

