<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Document</title>
</head>
<body>
        <header>
        <nav>
            <div class="logo">
                <img src="/images/logo2.png" alt="logo" width="100">
            </div>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/characters">Characters</a></li>
                <li><a href="/detail">Detail</a></li>
            </ul>
        </nav>
    </header>
    
    <main class="characters-grid">



            
    
    
        <article class="character-card">
            <div class="card-corner top-left"></div>
            <div class="card-corner top-right"></div>
            <div class="card-corner bottom-left"></div>
            <div class="card-corner bottom-right"></div>

            <div class="card-header">
                <span class="card-id">№ 10</span>
            </div>

            <div class="portrait-frame">
                <img src="images/jiraya.png" alt="Jiraiya" class="portrait" />
            </div>

            <h2 class="character-name">Jiraiya</h2>
            <p class="character-position">Jonin (Emeritus)</p>

            <p class="character-description">
                Jiraiya is een van de Legendarische Drie Shinobi van Konohagakure en de mentor van Naruto. Hij is beroemd om zijn krachtige technieken en zijn gulheid.
            </p>

            <div class="info-grid">
                <div class="info-row">
                    <span class="info-label">Leeftijd</span>
                    <span class="info-value">60</span>
                </div>
                <div class="info-row">
                    <span class="info-label">Geboortedatum</span>
                    <span class="info-value">15 november 1966</span>
                </div>
            </div>

            <div class="hobbies-section">
                <h3 class="section-heading">Hobby's</h3>
                <ul class="hobbies-list">
                    <li>Schrijven</li>
                    <li>Onderzoek</li>
                    <li>Trainen</li>
                </ul>
            </div>

            <div class="team-section">
                <h3 class="section-heading">Team</h3>
                <p class="team-name">Legendarische Drie</p>
                <p class="team-detail"><span>Leider:</span> Hashirama Senju</p>
                <p class="team-detail"><span>Dorp:</span> Konohagakure</p>
            </div>
        </article>
    
    </main>

</body>
</html>