<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/fonts.css">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/style.css">
    <title>Naruto</title>
</head>

<body class="">
        <header>
        <nav>
            <div class="logo">
                <img src="/images/logo2.png" alt="logo" width="200">
            </div>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/characters">Characters</a></li>
                <li><a href="/detail">Detail</a></li>
            </ul>
        </nav>
    </header>



   

    <main class="characters-grid">

        <% for(let character of characters) { %>
        <article class="character-card">
            <div class="card-corner top-left"></div>
            <div class="card-corner top-right"></div>
            <div class="card-corner bottom-left"></div>
            <div class="card-corner bottom-right"></div>

            <div class="card-header">
                <span class="card-id">№ <%= character.id.toString().padStart(2, '0') %></span>
            </div>

            <div class="portrait-frame">
                <img src="<%= character.image_url %>" alt="<%= character.name %>" class="portrait" />
            </div>

            <h2 class="character-name"><%= character.name %></h2>
            <p class="character-position"><%= character.position %></p>

            <p class="character-description">
                <%= character.description %>
            </p>
        </article>
        <% } %>


    </main>


</body>
</html>
    
    


